{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Игротека",
  "version": "1.1.0",
  "identifier": "com.lostheaven.igroteka",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Игротека",
        "url": "index.html",
        "width": 1040,
        "height": 820,
        "minWidth": 780,
        "minHeight": 620,
        "maximized": true,
        "decorations": false,
        "backgroundColor": "#020203",
        "devtools": true,
        "shadow": true,
        "zoomHotkeysEnabled": false,
        "limitNavigationsToAppBoundDomains": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
